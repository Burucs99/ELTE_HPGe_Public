
# /control/execute Eu152_Steel_Radii.mac
/run/numberOfThreads 11
/HPGe/run/EdepHist Edep Deposited-Energy 3000 0 3.1
/HPGe/det/setDeadLayer 2.5 1.5 2
/run/initialize

/gps/particle gamma
/gps/ang/mintheta 1.012 rad
/gps/ang/maxtheta 1.117 rad   
/gps/pos/type Point
/gps/ang/type iso
/gps/ang/mintheta 1.012 rad
/gps/ang/maxtheta 1.117 rad
/gps/ang/minphi -0.128431 rad
/gps/ang/maxphi 0.128431 rad
/gps/pos/centre 0 0 -0.8 cm

# ====================================================
# STEEL ANYAG BEÁLLÍTÁSA
# ====================================================
/HPGe/det/CreateIsotope Fe56 26 56 55.845
/HPGe/det/CreateElement Iron Fe Fe56:100
/HPGe/det/CreateMaterial Steel 7.8 Iron:100

# ====================================================
# FORRÁSHENGER: R = 5, 10, 15, 20, 25, 28.5 cm
# Az első paraméter 2R: 10, 20, 30, 40, 50, 57 cm
