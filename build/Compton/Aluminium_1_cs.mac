# /control/execute Compton/Aluminium.mac
/run/numberOfThreads 8
/HPGe/run/EdepHist Edep Deposited-Energy 3000 0 3.1
/run/initialize
/gps/pos/type Volume
/gps/pos/shape Cylinder
/gps/pos/radius 0.15875 cm
/gps/pos/halfz 0.001 mm

/gps/particle gamma
/gps/energy 661.7 keV



/HPGe/det/CreateIsotope Al27 13 27 26.981538
/HPGe/det/CreateElement Aluminum Al Al27:100
/HPGe/det/CreateMaterial Aluminum 2.70 Aluminum:100

/HPGe/det/setSourceBox AluminiumBox Aluminum 4.4 3.0 0.25 0 0 -6.250 ### Minima for 1 

/HPGe/det/setDeadLayer 2.5 1.5 2
/gps/pos/centre 0 0 -5.735 cm
/gps/ang/type iso
/HPGe/det/setCsSample 0.0 0.0 -5.735
/HPGe/det/setSampleHolderPosition 0.0 0.0 -3.2350
/run/reinitializeGeometry 1
/random/setSeeds 25698 25699

/HPGe/run/OutputName /home/aburucs/G4/Geant4/Gamma_Final/ELTE_HPGe_Public/build/Compton/1/ Compt_1
/run/beamOn 20000000
